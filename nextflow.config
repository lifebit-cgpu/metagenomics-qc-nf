manifest {
    name            = 'lifebit-cgpu/metagenomics-qc-nf'
    description     = 'QC for vendor-delivered (e.g. CosmosID) shotgun metagenomics FASTQ: FastQC, fastp, host depletion controlled by a per-sample metagenomic flag, classified fraction, top taxa, MultiQC'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version         = '0.1.0'
}

params {
    input                = null
    outdir               = 'results'
    publish_mode         = 'copy'
    generate_test_data   = false
    test_seed            = 42
    host_fasta           = null
    host_index           = null
    save_host_depleted   = false
    kraken2_db           = null
    classifier_fasta     = null
    min_length           = 50
    min_raw_pairs        = 5000
    min_retained_frac    = 0.5
    warn_host_frac       = 0.5
    warn_classified_frac = 0.5
    top_n_taxa           = 5
}

process {
    cpus          = 1
    memory        = '2 GB'
    time          = '4h'
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'terminate' }
    maxRetries    = 1

    withLabel: 'process_single' { cpus = 1; memory = '2 GB' }
    withLabel: 'process_low'    { cpus = 2; memory = '4 GB' }
    withLabel: 'process_medium' { cpus = 4; memory = '8 GB' }
    withLabel: 'process_high'   { cpus = 8; memory = '64 GB' }

    withName: 'MAKE_TEST_DATA|QC_SUMMARY|MULTIQC' { container = 'quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0' }
    withName: 'FASTQC'                            { container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0' }
    withName: 'FASTP'                             { container = 'quay.io/biocontainers/fastp:0.23.4--hadf994f_3' }
    withName: 'BOWTIE2_BUILD|BUILD_HOST_INDEX|BUILD_PANEL_INDEX|HOST_DEPLETE|CLASSIFY_PANEL' { container = 'quay.io/biocontainers/bowtie2:2.5.4--he96a11b_7' }
    withName: 'KRAKEN2'                           { container = 'quay.io/biocontainers/kraken2:2.1.3--pl5321hdcf5f25_3' }
}

profiles {
    test {
        params.generate_test_data = true
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    local {
        docker.enabled = false
        executor {
            name   = 'local'
            cpus   = 4
            memory = '7 GB'
        }
        process {
            withLabel: 'process_single' { cpus = 1; memory = '1 GB' }
            withLabel: 'process_low'    { cpus = 1; memory = '1.5 GB' }
            withLabel: 'process_medium' { cpus = 2; memory = '2 GB' }
            withLabel: 'process_high'   { cpus = 2; memory = '3 GB' }
        }
    }
}
