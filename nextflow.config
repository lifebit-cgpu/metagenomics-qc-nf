manifest {
    name            = 'lifebit-cgpu/metagenomics-qc-nf'
    author          = 'Lifebit'
    homePage        = 'https://github.com/lifebit-cgpu/metagenomics-qc-nf'
    description     = 'QC for vendor-delivered (CosmosID) shotgun metagenomics FASTQ: FastQC, fastp, optional host depletion, Kraken2, MultiQC'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '>=22.10.0'
    version         = '0.1.0'
}

params {
    // input
    input                     = null      // CSV: sample,fastq_1,fastq_2,metagenomic (TRUE/FALSE)
    outdir                    = 'results'
    test_data                 = false     // true = generate the synthetic test set inside the pipeline
    test_seed                 = 42

    // references
    host_fasta                = null      // host genome FASTA (bowtie2 index is built)
    bowtie2_index             = null      // OR a directory containing a prebuilt bowtie2 index
    kraken2_db                = null      // directory of a Kraken2 database (hash.k2d, opts.k2d, taxo.k2d)
    skip_kraken2              = false

    // trimming (fastp)
    fastp_qualified_quality   = 15
    fastp_unqualified_percent = 40
    fastp_min_length          = 50

    // QC flag thresholds
    min_reads                 = 5000      // raw read pairs below this -> FAIL
    max_host_fraction         = 0.5       // host fraction above this -> WARN
    min_retention             = 0.8       // fraction of pairs surviving trimming below this -> WARN
    max_contaminant_fraction  = 0.01      // fraction of classified input assigned to contaminant taxa -> WARN
    contaminant_taxids        = '10847'   // comma-separated NCBI taxids (default: PhiX174)
    top_n                     = 5

    // resources
    kraken2_memory            = '6 GB'
}

process {
    cpus          = 2
    memory        = '4 GB'
    time          = '4h'
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withName: 'MAKE_TEST_DATA' { container = 'python:3.12-slim';                                  cpus = 1; memory = '2 GB' }
    withName: 'QC_SUMMARY'     { container = 'python:3.12-slim';                                  cpus = 1; memory = '2 GB' }
    withName: 'FASTQC'         { container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0' }
    withName: 'FASTP'          { container = 'quay.io/biocontainers/fastp:0.23.4--h5f740d0_0' }
    withName: 'BOWTIE2_BUILD'  { container = 'quay.io/biocontainers/bowtie2:2.5.4--he96a11b_5' }
    withName: 'HOST_DEPLETION' { container = 'quay.io/biocontainers/bowtie2:2.5.4--he96a11b_5' }
    withName: 'KRAKEN2_BUILD'  { container = 'quay.io/biocontainers/kraken2:2.1.3--pl5321hdcf5f25_4' }
    withName: 'KRAKEN2'        { container = 'quay.io/biocontainers/kraken2:2.1.3--pl5321hdcf5f25_4'; memory = { params.kraken2_memory } }
    withName: 'MULTIQC'        { container = 'quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0';  cpus = 1 }
}

profiles {
    test {
        params.test_data = true
    }
    docker {
        docker.enabled = true
    }
    local {
        // run with tools already on PATH (no containers), used for development testing
        docker.enabled  = false
        process.cpus    = 1
        process.memory  = '2 GB'
    }
}
